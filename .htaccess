# .htaccess — Hardening de seguranca (REQ-001, REQ-009)
# Bloqueia acesso web a scripts de debug/manutencao/migration e arquivos de log

# Bloquear scripts de debug/manutencao na raiz
<FilesMatch "^(reset_admin|setup|repair_db|clean_db|reset_dados_producao|list_all|list_users)\.php$">
    Require all denied
</FilesMatch>

# Bloquear scripts com prefixos de debug/migration
<FilesMatch "^(check_|fix_|debug_|scan_|test_|migrate_|update_schema|update_routes_schema|add_|doc_|master_fix|binary_clean|final_clean|regex_clean|user_final_fix|update_users_fields)\.php$">
    Require all denied
</FilesMatch>

# Bloquear arquivos de log e audit (.txt, .log)
<FilesMatch "\.(txt|log)$">
    Require all denied
</FilesMatch>

# Bloquear acesso ao diretorio scratch/
RedirectMatch 403 ^/scratch/.*$
