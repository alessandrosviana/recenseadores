# .htaccess — Hardening de seguranca (REQ-001, REQ-009, V2-01)
# Bloqueia acesso web a scripts de debug/manutencao/migration e arquivos de log

# Bloquear acesso ao diretorio de manutencao (scripts de debug/migration movidos para ca)
RedirectMatch 403 ^/manutencao/.*$

# Bloquear arquivos de log e audit (.txt, .log) que possam existir na raiz
<FilesMatch "\.(txt|log)$">
    Require all denied
</FilesMatch>

# Bloquear acesso ao diretorio scratch/
RedirectMatch 403 ^/scratch/.*$
